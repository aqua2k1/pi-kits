{
  "$schema": "https://raw.githubusercontent.com/aqua2k1/pi-kits/main/pi-kits.schema.json",
  "pi-canvas-note": {
    "enabled": true,
    "portRange": [10000, 20000]
  },
  "pi-open": {
    "enabled": true
  },
  "pi-output-viewer": {
    "enabled": true,
    "editor": "nvim"
  },
  "pi-ask": {
    "enabled": true
  },
  "pi-subagent": {
    "enabled": true,
    "maxConcurrent": 4,
    "extensionAllowlist": [
      "builtin:codemode",
      "builtin:tool-search",
      {
        "source": "git:github.com/aqua2k1/pi-kits",
        "extensions": []
      }
    ]
  }
}
