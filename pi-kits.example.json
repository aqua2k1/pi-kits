{
  "$schema": "https://raw.githubusercontent.com/aqua2k1/pi-kits/main/pi-kits.schema.json",
  "terminal": {
    "editor": "nvim"
  },
  "canvas-note": {
    "enabled": true,
    "portRange": [10000, 20000]
  },
  "open": {
    "enabled": true
  },
  "preview": {
    "enabled": true
  },
  "askUserQuestion": {
    "enabled": true
  },
  "subagent": {
    "enabled": true,
    "maxConcurrent": 4,
    "extensionAllowlist": [
      "builtin:codemode",
      "builtin:tool-search",
      {
        "source": "git:github.com/aqua2k1/pi-kits",
        "extensions": []
      }
    ]
  },
  "web-kits": {
    "enabled": true,
    "search": {
      "enabled": true,
      "sources": {
        "web": {
          "enabled": true,
          "routing": ["searxng"],
          "codex": {
            "model": "gpt-6-luna"
          }
        },
        "github": {
          "enabled": true
        }
      },
      "timeoutMs": 15000,
      "maxResults": 5
    },
    "fetch": {
      "enabled": true,
      "timeoutMs": 15000,
      "github": {
        "enabled": true
      }
    }
  }
}
