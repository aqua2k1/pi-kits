          "minimum": 1,
          "maximum": 32,
          "default": 4
        },
        "extensionAllowlist": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"
              },
              {
                "type": "object",
                "required": ["source", "extensions"],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"
