{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "pi-canvas-note": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "portRange": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          ],
          "minItems": 2,
          "default": [10000, 20000]
        }
      },
      "additionalProperties": true
    },
    "pi-open": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": true
    },
    "pi-output-viewer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "editor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "default": "nvim"
        }
      },
      "additionalProperties": true
    },
    "pi-ask": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": true
    },
    "pi-subagent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 4
        },
        "extensionAllowlist": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"
              },
              {
                "type": "object",
                "required": ["source", "extensions"],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"
                  },
                  "extensions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "uniqueItems": true,
          "description": "Pi extension sources or package selections using declared extensionResources names. Relative paths use the agent directory.",
          "default": ["builtin:codemode", "builtin:tool-search"]
        }
      },
      "additionalProperties": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aqua2k1/pi-kits/main/pi-kits.schema.json",
  "title": "Pi Kits configuration",
  "additionalProperties": true
}
