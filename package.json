{
  "name": "pi-kits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./packages/workspace-kit/src/extensions/terminal.ts",
      "./packages/workspace-kit/src/extensions/open.ts",
      "./packages/workspace-kit/src/extensions/preview.ts",
      "./packages/workspace-kit/src/extensions/context-preview.ts",
      "./packages/usage-kit/src/extensions/provider-usage/index.ts",
      "./packages/usage-kit/src/extensions/stats/index.ts",
      "./packages/workflow-kit/src/extensions/commit/index.ts",
      "./packages/workflow-kit/src/extensions/notify/index.ts",
      "./packages/web-kit/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "26.4.1",
    "tsx": "4.21.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
