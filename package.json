{
  "name": "pi-kits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "extensionResources": {
    "terminal": "./extensions/terminal/index.ts",
    "open": "./extensions/open/index.ts",
    "preview": "./extensions/preview/index.ts",
    "context-preview": "./extensions/context-preview/index.ts",
    "provider-usage": "./extensions/provider-usage/index.ts",
    "stats": "./extensions/stats/index.ts",
    "commit": "./extensions/commit/index.ts",
    "notify": "./extensions/notify/index.ts",
    "ask-user-question": "./extensions/ask-user-question/index.ts",
    "subagent": "./extensions/subagent/index.ts",
    "web-kits": "./extensions/web-kits/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/terminal/index.ts",
      "./extensions/open/index.ts",
      "./extensions/preview/index.ts",
      "./extensions/context-preview/index.ts",
      "./extensions/provider-usage/index.ts",
      "./extensions/stats/index.ts",
      "./extensions/commit/index.ts",
      "./extensions/notify/index.ts",
      "./extensions/ask-user-question/index.ts",
      "./extensions/subagent/index.ts",
      "./extensions/web-kits/index.ts"
    ],
    "themes": [
      "./themes/gruvbox.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "workspaces": [
    "extensions/*",
    "shared",
    "shared/config",
    "themes"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "26.4.1",
    "@types/ws": "^8.18.2",
    "tsx": "4.21.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
