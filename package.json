{
  "name": "pi-kits",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "extensionResources": {
    "pi-canvas-note": "./extensions/pi-canvas-note/index.ts",
    "pi-open": "./extensions/pi-open/index.ts",
    "pi-output-viewer": "./extensions/pi-output-viewer/index.ts",
    "pi-token-meter": "./extensions/pi-token-meter/index.ts",
    "pi-handoff": "./extensions/pi-handoff/index.ts",
    "pi-ask": "./extensions/pi-ask/index.ts",
    "pi-subagent": "./extensions/pi-subagent/index.ts",
    "pi-server-tools": "./extensions/pi-server-tools/index.ts",
    "pi-image": "./extensions/pi-image/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-canvas-note/index.ts",
      "./extensions/pi-open/index.ts",
      "./extensions/pi-output-viewer/index.ts",
      "./extensions/pi-token-meter/index.ts",
      "./extensions/pi-handoff/index.ts",
      "./extensions/pi-ask/index.ts",
      "./extensions/pi-subagent/index.ts",
      "./extensions/pi-server-tools/index.ts",
      "./extensions/pi-image/index.ts"
    ],
    "themes": [
      "./themes/gruvbox.json"
    ],
    "skills": [
      "./extensions/pi-canvas-note/skills/canvas-note"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "workspaces": [
    "extensions/*",
    "shared",
    "themes"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "26.4.1",
    "@types/ws": "^8.18.2",
    "tsx": "4.21.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
