{
  "name": "pi-workflow-kit",
  "version": "0.1.0",
  "description": "Pi commit workflow and native desktop completion notifications",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    "./notifications": "./src/lib/notifications/index.ts"
  },
  "scripts": {
    "test": "tsx --test src/extensions/commit/*.test.ts src/extensions/notify/*.test.ts src/lib/notifications/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/extensions/commit/index.ts",
      "./src/extensions/notify/index.ts"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  }
}
